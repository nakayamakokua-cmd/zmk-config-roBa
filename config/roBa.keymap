#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E         &kp R         &kp T                                        &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D         &kp F         &kp G      &kp N7                 &kp MINUS  &kp H          &kp J  &kp K      &kp L    &kp SQT
&kp Z      &kp X         &kp C         &kp V         &kp B      &kp COLON              &kp SEMICOLON &kp N       &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp N1     &kp N2        &kp N3        &kp N4        &kp N5     &kp N6                 &kp N8     &kp N9                                    &kp N0
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };
    };
};

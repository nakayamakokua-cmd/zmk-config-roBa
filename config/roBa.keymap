// 100 = 1目盛り=1単位に減量(2026-09-01 中山「少し動かしただけでめっちゃスクロールされる」対応。旧160=2単位)。
// 1目盛りの出力 = int(この値 × trigger-period-ms(既定16) / 1000)。整数部しか出ない。
//   端数(remainder)はtick間では持ち越されるが、目盛りごとの解放時に必ず破棄される
//   (behavior_input_two_axis.c: k_work_cancel時に remainder=0。v0.3-branchソースで確認済)。
// 🔴 つまり 63〜124 はすべて「1」で挙動が同じ。62以下は出力0に切り捨て=【無言で無反応】になる。
//    1目盛り=1単位がこの仕組みの下限。これ以上減らしたければmacOS側のスクロール速度設定で絞る。
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <200>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;

    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        // 右手側の Tab / Shift+Tab (2026-08-19 中山指示。コンボを右手へ寄せる方針)
        // 🔴 layers = <0> が必須。コンボは既定で全レイヤーに効くため、指定しないと
        //    ボール操作で自動的に開く MOUSE層(4) でも発火し、J/K/L のクリックに混ざる。
        //    Default層に限れば、ボールを触っている間はクリックのまま・手を止めれば Tab。
        // Pの下を長押し(=Cmd) しながら J+K を叩くと ⌘Tab のアプリ切り替えになる。
        //    Cmd保持はレイヤーを変えないので layers = <0> と両立する。
        tab_right {
            bindings = <&kp TAB>;
            key-positions = <18 19>;
            layers = <0>;
        };

        shift_tab_right {
            bindings = <&kp LS(TAB)>;
            key-positions = <19 20>;
            layers = <0>;
        };

        // 右手だけでSpace(2026-08-27 中山指示)。M位置(30) + カンマ位置(31)。
        // layers = <0> は必須。無指定だと全レイヤーに効くため、
        //   ・MOUSE層(4): M=⌘C / カンマ=⌘V に混ざる(ボール操作で自動的に開く層)
        //   ・NUM層(2)  : M=← / カンマ=↓ の同時押し(斜め移動)でSpaceが暴発
        // ローマ字入力ではmの直後に必ず母音が来るので、m→カンマの連続打鍵は構造的に発生しない。
        space_right {
            bindings = <&kp SPACE>;
            key-positions = <30 31>;
            layers = <0>;
        };
    };

    // layer_6(BT設定・ブートローダー)の入口。
    // 旧: 変換キー長押し → 変換位置をLeft Commandにしたため廃止(2026-08-13)。
    // 旧2: Del位置(→layer1) + Enter(→layer3) の同時長押し(2026-08-13〜2026-09-01)。
    // 現行: 🔴 スラッシュ位置(→layer1) と Enter(→layer3) を両方200ms以上ホールド。
    //     2026-09-01にlayer1の入口をDel位置→スラッシュへ移したため、ここも連動して変わった
    //     (判定は「レイヤー1と3が同時に開いている」なので、物理キーはlayer1/3の入口に追随する)。
    //     右手だけで完結するので、左手が故障していてもブートローダーに入れる。
    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_layer {
            if-layers = <1 3>;
            then-layer = <6>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // ── 英字キーの長押しに機能を持たせる用(2026-08-19新設) ──────────────
        // Z の長押し = Shift。Z は【左手小指】＝離すのが遅い指。
        // ⚠️ 同日の後段で A の長押し Tab は撤去した(素の &kp A へ)。理由:
        //    中山の当初の狙いは ⌘Tab のアプリ切り替えだったが、⌘Tab は「Tabを何回も叩く」
        //    操作なので「1回出すのに400ms」の hold-tap は構造的に向かない。
        //    Shift+Tab も D+F コンボで足り、単発 Tab も S+D で足りる。
        //    最頻出キーである A に誤爆の余地を残す理由が無くなったため撤去。
        //    → 代わりに右手側へ J+K(Tab) / K+L(Shift+Tab) のコンボを新設した。
        //
        // 🔴 flavor = "tap-preferred" が今回の肝。中山の優先順位は
        //    「日常のタイピングを絶対に壊さない」＞「修飾キー操作の速さ」(2026-08-19明言)。
        //
        //  なぜ balanced ではダメか(2026-08-13に &mt LEFT_SHIFT Z を廃止した理由そのもの):
        //    balanced は「このキーを押している間に、別のキーが押されて離された」を見て
        //    長押しと判定する。ローマ字入力では「ず(z→u)」「ざ(z→a)」で
        //    Z押下 → U押下 → U解放 → Z解放 の順になることがあり(小指は離れるのが遅い)、
        //    その瞬間に Shift 確定 → 「ず」が「U」になる。
        //    中山の名前が「かずや」で毎回Zを打つため、この誤爆を実際に踏んでいた。
        //    🔴 この経路は tapping-term-ms を伸ばしても防げない。
        //       balanced は term 満了を待たずに「他キーの押して離す」だけで確定するため。
        //       term が効くのは「単独で長く握る」経路のみ。ここを取り違えないこと。
        //
        //  tap-preferred は「他のキーが押された時点で、迷わず英字を出す」。
        //    → 上のロール誤爆は【構造的に】起きなくなる。残る誤爆経路は
        //      「そのキーだけを term 以上、他に触らず握ったまま止まる」1通りだけ。
        //
        //  失うもの: 修飾キーとしての即応性。Shift+C は「Zを400ms握ってからC」になる。
        //    打鍵の流れの中で大文字を混ぜる用途には向かない。
        //    → 従来どおりの独立した Shift キーが左手下段2番目に残っているので、そちらを使う。
        //
        // 設定値:
        //   tapping-term-ms = 400 : これだけ握って初めて長押し確定。人間の通常の打鍵は
        //                           1キー70〜200msなので、日常打鍵の2〜5倍のマージン。
        //                           🔴 遅いと感じたら 400→300 に下げる(誤爆の余地は増える)。
        //                              逆にまだ化けるなら 400→500 に上げる。
        //   quick-tap-ms  = 200   : 直前に同じキーをタップしていたら必ず英字。
        //                           「かずや」を打ち直す時の連打や、長押しリピートを守る。
        alpha_hold: alpha_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "ALPHA_HOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
        };

        // 🔴 2026-09-01から未使用(Pの下を &lt 2 LC(SPACE) に変更したため)。定義だけ残置
        //    (同日R20でMOUSE層のPの下も⌘→進むに変わり、当初想定した再利用先も消えた)。
        // Pの下(RC(1,11)) 用。タップ = Ctrl+Space(IME切替) / 長押し = 左Command。
        // 2026-08-19 中山指示: MOUSE層の同じ位置が `&kp LGUI` なので、Default層でも
        // 同じ位置を長押しCmdにして「ボールを触っていてもいなくても同じ指の動き」に揃える。
        //
        // 🔴 flavor は "balanced" でなければならない(alpha_hold の tap-preferred は使えない)。
        //    tap-preferred は他キーの press 時点で tap を確定するため、Cmd を保持したまま
        //    別のキーを打つ = 修飾キーとしての用途が成立しない(Ctrl+Space が出てしまう)。
        //    balanced なら「他キーの押して離す」で hold 確定 → ⌘C / ⌘Tab が自然に効く。
        //  誤爆の向き: Z/A と逆で「押したまま次を打つ」が正常な使い方なので、
        //    ロール誤爆という概念がない。代わりに「単独でゆっくり押すと Cmd に化ける」側だけ
        //    気にすればよく、それは tapping-term で調整する。
        //
        //   tapping-term-ms = 250 : IME切替は叩く操作(通常70-150ms)なので余裕を持たせた。
        //                           🔴 IME切替が Cmd に化けるなら 250→350 に上げる。
        //                              Cmd を出すのが遅いなら 250→200 に下げる。
        //   quick-tap-ms  = 200   : 直前にタップしていたら必ず Ctrl+Space。
        //                           切り替えすぎて即戻す時の連打を守る。
        cmd_ime: cmd_ime {
            compatible = "zmk,behavior-hold-tap";
            label = "CMD_IME";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
        };

        // エンコーダでマウスホイールスクロール。
        //
        // 🔴 tap-ms は「短すぎると効かない・長すぎると固まる」の両側に崖がある。25が現行の着地点。
        //
        //  下側の崖(5ms=既定): &msc は trigger-period-ms(既定16ms)ごとにしか発火しないので、
        //    押下→解放が16msより短いと一度も出力されない。2026-08-09〜08-14の無反応はこれ。
        //  上側の崖(40ms): sensor-rotate は1目盛りごとに共有の behavior queue へ
        //    「押す(wait=tap-ms)」「離す(wait=0)」を積む。行列は直列処理なので
        //    1目盛りが tap-ms ぶん行列を占有し、40msだと毎秒25目盛りしか捌けない。
        //    triggers-per-rotation=10 なので毎秒2.5回転を超えると行列が伸び、
        //    溢れると zmk_behavior_queue_add の戻り値は捨てられるため黙って落ちる。
        //    「押す」が先に積まれるので境界では【離すだけが消え】、&msc の速度が
        //    ゼロに戻らず永久スクロールになる(2026-08-14に実機で発生)。
        //
        // 対策: tap-ms=25(16ms周期を1回だけ跨ぐ最小付近) + queue 64→256(roBa_R.conf)
        //       これは穴を塞ぐのではなく余裕を約6倍に広げる対処。極端な高速回転では理屈上まだ再発しうる。
        //       確実に固めたくない場合の唯一の安全策は &inc_dec_kp PG_UP PG_DN へ戻すこと。
        // 復旧方法: 固まったら電源スイッチOFF→ON(内部の速度状態が消える)。
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_ENCODER";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <25>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 左手下段(外側→内側): Ctrl / Shift / Alt / 右Cmd / Space / 左Cmd
        //   2026-08-14に左右Cmdの位置を入れ替え、さらにENCODER層(音量)のトリガーを
        //   いちばん内側=エンコーダに近い側(無変換位置)へ戻した(中山指示)。
        //   🔴 押しっぱなしにできるのは【右Cmd(変換位置)】。Cmd+C等の修飾用途はこちらを使う。
        //      左Cmd(無変換位置)は長押しでENCODER層が開くのでタップ専用。
        //   左右Commandのタップは BetterTouchTool 側で半角/英数の切替に割り当てて使う。
        //   Pの下: クォート→伸ばし棒→【Ctrl+Space(IME切替)】へ再移設(2026-08-14)。伸ばし棒は内側上の1箇所に戻った。
        //   🔴 右手内側の下(RC(3,7))は旧Ctrl+Space→【B】に変更。分割前は右手人差し指でBを打っていた癖に合わせる。
        //      この位置は layer_6 で【右手ブートローダー】でもある(物理位置で固定)。
        //      呼び方を『Ctrl+Space位置』→『Bの位置』に更新すること。手順書の記述も追随済み。
        //   FUNCTION層(1): Pの位置=Alt+C(Ghosttyのkeybindが /clear + Enter に展開)
        //                 Pのすぐ下=Alt+P(Claude Code内蔵のモデル選択を開く)
        //   ⛔ 2026-09-01で解消 〜旧: Del位置は &lt 1 RIGHT_ALT ＝ RightAltを押しっぱなしに
        //      できない〜 → Del位置を素の &kp RIGHT_ALT に変更したため押しっぱなし可能になった。
        //      レイヤー1の完成形(LA(x))キーは残置(慣れた操作を先に消さない)。
        //
        //   2026-08-19: Z に長押しの二役を追加(中山指示)。実機で「かずや」の誤爆が
        //     解消したことを確認済み。
        //     Z: タップ=Z / 長押し(400ms)=Shift (2026-08-13に廃止した &mt LEFT_SHIFT Z の
        //        復活。ただし当時の誤爆の原因だった判定方式は変えてある)
        //     🔴 「他のキーを押した瞬間に英字が確定する」方式(tap-preferred)。
        //        長押しを出すには【Zだけを400ms握る】。理由は behaviors の alpha_hold。
        //     A は同日に一度 Tab を載せたが撤去済み(理由は alpha_hold のコメント)。
        //
        //   2026-08-19: Pの下(idx21) を `&cmd_ime LGUI LC(SPACE)` に変更(中山指示)。
        //     タップ=Ctrl+Space(IME切替・従来どおり) / 長押し=左Command。
        //     MOUSE層の同じ位置が `&kp LGUI` なので、ボールを触っていてもいなくても
        //     同じ指の動きで Cmd を保持できるように揃えた。
        //     ⌘Tab は「Pの下を長押し + J+K を叩く」で右手だけで完結する。
        //
        //   🔴 2026-09-01(ラウンド19) 入口の大移動(中山指示):
        //     ・Pの下 = &lt 2 LC(SPACE)。タップ=⌃Space(IME・従来どおり) / 長押し=NUM層(2)。
        //       長押し⌘は廃止 → ⌘Tabの「Pの下+J+K」フローも消滅。代替=Oを0.4秒握って⌘+J+K。
        //     ・スラッシュ = &lt 1 SLASH。長押しがNUM層→FUNCTION層(1)に変更。
        //     ・Del位置 = 素の &kp RIGHT_ALT(押しっぱなし可能になった)。
        //     ・O = &alpha_hold LGUI O。タップ=O / 0.4秒握る=⌘。
        //       🔴 flavor は tap-preferred(Zと同じ)が必須。Oは母音で最頻出級のため、
        //       balanced だとローマ字のロール(「ou」等)で ⌘U など破壊的誤爆が出る。
        //       代償: ⌘コンボは「Oを0.4秒握ってから」の2拍(R20でMOUSE層のPの下⌘も
        //       廃止したため、右手の⌘はOに一本化。左手なら右Cmdが常に即時)。
        //     ・layer_6(書き込みモード)の入口もスラッシュ+Enterに連動変更(conditional_layers参照)。
        default_layer {
            bindings = <
&kp Q                      &kp W           &kp E         &kp R     &kp T                                     &kp Y          &kp U        &lt 5 I  &alpha_hold LGUI O  &kp P
&kp A                      &kp S           &kp D         &kp F     &kp G        &kp F13                      &kp MINUS      &kp H        &kp J    &kp K      &kp L    &lt 2 LC(SPACE)
&alpha_hold LEFT_SHIFT Z   &kp X           &kp C         &kp V     &kp B        &kp COLON                    &kp B          &kp N        &kp M    &kp COMMA  &kp DOT  &lt 1 SLASH
&kp LCTRL                  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp RGUI  &lt 7 SPACE  &lt 8 LGUI                   &kp BACKSPACE  &lt 3 ENTER                                &kp RIGHT_ALT
            >;

            // 2026-08-14: マウスホイール化が動作したため PageUp/Down から昇格。
            // 同日、高速回転で永久スクロールになる不具合を回収し tap-ms を 40→25 に。詳細は behaviors 側のコメント。
            sensor-bindings = <&scroll_encoder>;
        };

        // FUNCTION(1): 🔴 スラッシュ位置の長押し中(2026-09-01にDel位置長押しから移設)。
        //   2026-08-27に右手を全面再編(中山指示)。
        //   上段: Y=Escape  U=Alt+R  I=Alt+F  O=Alt+W  P=Alt+C(Ghostty経由で /clear)
        //   中段: J=Alt+N   K=Alt+S  L=Alt+Shift+N   Pの下=Alt+P(モデル選択)
        //   下段: N=Ctrl+V  M=Ctrl+Shift(単体)  カンマ=Ctrl+U  ピリオド=Ctrl+J
        //   ※ Alt系はターミナル/エディタ側のキーバインド用。レイヤーの入口キーは
        //     修飾キーとして押しっぱなしにできないため、完成形(LA(x))を層に置くのが唯一の手。
        //   ※ 2026-08-27の後段でさらに移動: Ctrl+V を B位置(idx28)→N位置(idx29)へ。
        //     B位置は空けた(MOUSE層で同じ位置に⌘⇧4を置いたので、指の記憶を衝突させない)。
        // 🔴 この再編で消えた機能(意図的・中山指示の結果):
        //   ・M位置の &kp LGUI(Cmd押しっぱなし) → レイヤー1経由の⌘Tab(M保持+ピリオド連打)が消滅。
        //     代替はラウンド14で作った右手コンボ(Pの下を長押し=⌘ + J+K=Tab)。
        //   ・J=Ctrl+Shift+Tab / L=Ctrl+Tab のタブ前後切替が両方消滅。
        //     代替はRNUM層(Enter長押し)のエンコーダ回転=Ctrl+PageUp/Down。
        //   ・K位置のMission Control と カンマ位置のF4(Launchpad) はNUM層(2)のO/L位置へ移設。
        //   ・Ctrl+U はH位置から、Ctrl+J はU位置から移動(元の位置は素通しに戻した)。
        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp ESCAPE  &kp LA(R)   &kp LA(F)      &kp LA(W)  &kp LA(C)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans      &kp LA(N)      &kp LA(S)  &kp LA(LS(N))  &kp LA(P)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LC(V)   &kp LC(LSHFT)  &kp LC(U)  &kp LC(J)      &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                               &trans
            >;
        };

        // NUM(2): 🔴 Pの下の長押し中(2026-09-01にスラッシュ長押しから移設)。
        //   2026-09-01: 右手を再編(中山指示)。矢印を1段上げてホーム段の逆T字に:
        //     I=↑ / J=← / K=↓ / L=→。U=Mission Control(⌃↑) / O=F4(Launchpad) /
        //     M=⌘W(タブ閉じる) / カンマ=⌘⇧T(タブ復元)。
        //     ~(チルダ)は↑に押し出されたため、空いたピリオド位置(idx32)へ退避(指示外・要報告)。
        //   🔴 入口がPの下(idx21)になったので、この層のidx21(%)は押せない=死に機能。
        //      %はRNUM層(Enter長押し)の同じ位置に生きているので実害なし。
        //   2026-08-27: レイヤー1から追い出したウィンドウ操作をここへ移設(中山指示)。
        //   🔴 代償: "(" はSYMBOL層(Space長押し)のD位置に同じものが残るが、
        //      "$" はこの位置が唯一だったのでキーボードから消えた。
        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                   &kp CARET         &kp LC(UP_ARROW)   &kp UP_ARROW    &kp F4                &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp LEFT_ARROW     &kp DOWN_ARROW    &kp RIGHT_ARROW       &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp LG(W)          &kp LG(LS(T))     &kp TILDE             &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        RNUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp ASTERISK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans      &kp PLUS   &kp SLASH        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PERCENT
&trans  &trans  &trans  &trans  &trans  &trans      &kp MINUS  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        // MOUSE(4): ボールを触ると自動で開く。2026-08-27に中山指示で整理。
        //   idx21(Pの下) = &kp LGUI のまま【据え置き】。
        //     🔴 一度 &mkp MB5(進む) にしたが、焼く前に中山判断で撤回した(2026-08-27)。
        //        理由: ボール操作中に⌘を保持できなくなるのが痛い(⌘クリック=新しいタブで開く)。
        //        MOUSE層が開いている間はMOUSE層の定義が優先されるため、この位置を
        //        MB5にすると Default層の hold-tap(長押し=⌘) は一切効かなくなる。
        //     ※ ボールを触った直後のIME切替が⌘に化ける件は未解決のまま残る
        //        (この位置はMOUSE層では【押した瞬間に⌘】になるため)。
        //   idx5(Y) = &trans → **&mkp MB5(進む)**。空いていた位置へ移した。
        //     H=戻る(MB4) とは離れた位置になるが、⌘を残すことを優先した。
        //   idx16(伸ばし棒) = ⌘⇧V(書式なし貼り付け)。idx8(O)から移設。
        //   idx28(B位置)   = ⌘⇧4(範囲スクショ)。idx29(N)から移設。
        //   idx6(U)        = ⌃⌘V を削除(使っていない)。
        //   idx29(N)       = &trans → **&kp LC(V)**(Ctrl+V)。⌘⇧4をB位置へ移して空いた場所。
        //   2026-09-01: idx33(スラッシュ位置)=⌘Z(取り消し) / idx42(Del位置)=⌘⇧Z(やり直し)。
        //     レイヤー入口キーの位置でも、MOUSE層が開いている間はMOUSE層の定義が優先される
        //     ので普通に割り当てられる。ボールが止まって0.7秒経つと
        //     MOUSE層が閉じ、同じキーが「/(長押しLayer1)」「RightAlt」に戻る点だけ注意。
        //   2026-09-01(R20): idx21(Pの下) = &kp LGUI → **&mkp MB5(進む)** / idx5(Y) = &trans に戻す。
        //     R16で「ボール中の⌘保持(⌘クリック)が消えるから」と撤回した配置だが、
        //     R19でO長押し=⌘ができて前提が変わった(中山指示)。MOUSE層のidx8(O)は&trans=
        //     Default層のalpha_holdに落ちるので、ボール操作中もOで⌘を作れる。
        //     ⌘クリックの新しい形=「Oを握りながら狙う→クリック」(狙う時間が0.4秒を吸収)。
        //     🔴 副作用: ボール直後にPの下を叩く誤爆が「⌘に化ける」→「進むに化ける」に変わった
        //       (実害が出るのは進む履歴がある画面のみ。従来の未解決問題の形が変わっただけ)。
        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LG(LS(V))  &mkp MB4  &mkp MB1  &kp LG(A)  &mkp MB2  &mkp MB5
&trans  &trans  &trans  &trans  &trans  &trans      &kp LG(LS(NUMBER_4))  &kp LC(V)  &kp LG(C)  &kp LG(V)  &kp LG(X)  &kp LG(Z)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &kp LG(LS(Z))
            >;
        };

        // Iキー長押し中。ボール移動がスクロールになる。
        // エンコーダ回転は2026-08-14にDefault層へ昇格したので、この層の個別指定は撤去。
        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // BT設定・ブートローダー。入口 = 🔴 スラッシュ位置 と Enter の同時長押し(2026-09-01変更)
        // 🔴 スラッシュ位置とEnterは「入口として押しっぱなしにしている」ため、この層では押せない=
        //    そこに機能を置いてはいけない。BT_CLR_ALL は旧Del位置からBackSpace位置へ退避済(2026-08-14)。
        //    BT_CLR(そのプロファイル解除)も同じ理由で 2026-09-01 にスラッシュ位置→ピリオド位置へ退避。
        layer_6 {
            bindings = <
&bootloader  &trans        &trans        &trans        &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &bt BT_CLR    &trans
&trans  &trans        &trans        &trans        &trans  &trans      &bt BT_CLR_ALL  &trans                                               &trans
            >;
        };

        // SYMBOL: 左手Space長押し中。記号を出す層(2026-08-13新設)
        //   Q=Esc  W=!  E=?  R=@  T=_ / D=(  F=) / C=<  V=>   ぜんぶ左手で完結する
        //   2026-08-19: Q=Escape と T=アンダーバー を追加(中山指示)。
        //   Escapeは記号ではないが「Space長押し中に左手小指ひとつで抜けられる」ことを優先。
        SYMBOL {
            bindings = <
&kp ESCAPE  &kp EXCLAMATION  &kp QUESTION          &kp AT_SIGN            &kp UNDERSCORE                      &trans  &trans  &trans  &trans  &trans
&trans      &trans           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans           &kp LESS_THAN         &kp GREATER_THAN       &trans          &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans      &trans           &trans                &trans                 &trans          &trans      &trans  &trans                          &trans
            >;
        };

        // ENCODER: 左手下段いちばん内側(左Cmd)の長押し中。回転 = 音量上下。
        //   押し込みは Default 層で常時F13にしたので、この層では &trans で素通し(2026-08-14)。
        //   2026-09-01: 回転方向を反転(中山「上から下で音量が上がるのは直感に反する」)。
        //   &inc_dec_kp は <正方向, 逆方向> の並び。UP/DOWNを入れ替えた。
        ENCODER {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };
    };
};

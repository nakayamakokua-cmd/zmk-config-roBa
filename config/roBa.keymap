// 160 = tap-ms短縮(40→25ms)で1目盛りあたりの発火が2回→1回に減るぶんの補正。
// 1発火の移動量 = この値 × trigger-period-ms(既定16) / 1000 = 2.56 → 従来の2回ぶんと同等。
#define ZMK_POINTING_DEFAULT_SCRL_VAL 160

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <200>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;

    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    // layer_6(BT設定・ブートローダー)の入口。
    // 旧: 変換キー長押し → 変換位置をLeft Commandにしたため廃止(2026-08-13)。
    // 新: Del位置(→layer1) と Enter(→layer3) を両方200ms以上ホールドすると layer_6 が出る。
    //     右手だけで完結するので、左手が故障していてもブートローダーに入れる。
    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_layer {
            if-layers = <1 3>;
            then-layer = <6>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダでマウスホイールスクロール。
        //
        // 🔴 tap-ms は「短すぎると効かない・長すぎると固まる」の両側に崖がある。25が現行の着地点。
        //
        //  下側の崖(5ms=既定): &msc は trigger-period-ms(既定16ms)ごとにしか発火しないので、
        //    押下→解放が16msより短いと一度も出力されない。2026-08-09〜08-14の無反応はこれ。
        //  上側の崖(40ms): sensor-rotate は1目盛りごとに共有の behavior queue へ
        //    「押す(wait=tap-ms)」「離す(wait=0)」を積む。行列は直列処理なので
        //    1目盛りが tap-ms ぶん行列を占有し、40msだと毎秒25目盛りしか捌けない。
        //    triggers-per-rotation=10 なので毎秒2.5回転を超えると行列が伸び、
        //    溢れると zmk_behavior_queue_add の戻り値は捨てられるため黙って落ちる。
        //    「押す」が先に積まれるので境界では【離すだけが消え】、&msc の速度が
        //    ゼロに戻らず永久スクロールになる(2026-08-14に実機で発生)。
        //
        // 対策: tap-ms=25(16ms周期を1回だけ跨ぐ最小付近) + queue 64→256(roBa_R.conf)
        //       これは穴を塞ぐのではなく余裕を約6倍に広げる対処。極端な高速回転では理屈上まだ再発しうる。
        //       確実に固めたくない場合の唯一の安全策は &inc_dec_kp PG_UP PG_DN へ戻すこと。
        // 復旧方法: 固まったら電源スイッチOFF→ON(内部の速度状態が消える)。
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_ENCODER";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <25>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 左手下段(外側→内側): Ctrl / Shift / Alt / 右Cmd / Space / 左Cmd
        //   2026-08-14に左右Cmdの位置を入れ替え、さらにENCODER層(音量)のトリガーを
        //   いちばん内側=エンコーダに近い側(無変換位置)へ戻した(中山指示)。
        //   🔴 押しっぱなしにできるのは【右Cmd(変換位置)】。Cmd+C等の修飾用途はこちらを使う。
        //      左Cmd(無変換位置)は長押しでENCODER層が開くのでタップ専用。
        //   左右Commandのタップは BetterTouchTool 側で半角/英数の切替に割り当てて使う。
        //   Pの下: クォート→伸ばし棒→【Ctrl+Space(IME切替)】へ再移設(2026-08-14)。伸ばし棒は内側上の1箇所に戻った。
        //   🔴 右手内側の下(RC(3,7))は旧Ctrl+Space→【B】に変更。分割前は右手人差し指でBを打っていた癖に合わせる。
        //      この位置は layer_6 で【右手ブートローダー】でもある(物理位置で固定)。
        //      呼び方を『Ctrl+Space位置』→『Bの位置』に更新すること。手順書の記述も追随済み。
        //   FUNCTION層(1)のPの位置に Alt+C を配置。Ghostty の keybind が /clear + Enter に展開する。
        default_layer {
            bindings = <
&kp Q      &kp W              &kp E         &kp R      &kp T                                             &kp Y          &kp U        &lt 5 I  &kp O      &kp P
&kp A      &kp S              &kp D         &kp F      &kp G        &kp F13                              &kp MINUS      &kp H        &kp J    &kp K      &kp L    &kp LC(SPACE)
&kp Z      &kp X              &kp C         &kp V      &kp B        &kp COLON                            &kp B          &kp N        &kp M    &kp COMMA  &kp DOT  &lt 2 SLASH
&kp LCTRL  &kp LEFT_SHIFT     &kp LEFT_ALT  &kp RGUI   &lt 7 SPACE  &lt 8 LGUI                           &kp BACKSPACE  &lt 3 ENTER                                &lt 1 RIGHT_ALT
            >;

            // 2026-08-14: マウスホイール化が動作したため PageUp/Down から昇格。
            // 同日、高速回転で永久スクロールになる不具合を回収し tap-ms を 40→25 に。詳細は behaviors 側のコメント。
            sensor-bindings = <&scroll_encoder>;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &kp ESCAPE  &kp LC(J)       &trans  &trans           &kp LA(C)
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &kp LC(U)   &kp LC(LS(TAB))  &kp LC(UP_ARROW)  &kp LC(TAB)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp LC(V)   &kp LC(LSHFT)  &kp LGUI  &kp F4  &kp TAB  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                                                       &trans
            >;
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                                   &kp CARET         &kp LG(LS(T))      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp LG(W)          &kp UP_ARROW      &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp LEFT_ARROW     &kp DOWN_ARROW      &kp RIGHT_ARROW     &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans                       &trans          &trans                                                                     &kp PIPE
            >;
        };

        RNUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp ASTERISK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp EQUAL
&trans  &trans  &trans  &trans  &trans  &trans      &kp PLUS   &kp SLASH        &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PERCENT
&trans  &trans  &trans  &trans  &trans  &trans      &kp MINUS  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &kp LC(LG(V))    &trans    &kp LG(LS(V))  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB4  &mkp MB1  &mkp MB3  &mkp MB2  &kp LGUI
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp LG(LS(NUMBER_4))  &kp LG(C)  &kp LG(V)  &kp LG(X)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        // Iキー長押し中。ボール移動がスクロールになる。
        // エンコーダ回転は2026-08-14にDefault層へ昇格したので、この層の個別指定は撤去。
        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // BT設定・ブートローダー。入口 = Del位置 と Enter の同時長押し(conditional_layers)
        // 🔴 Del位置とEnterは「入口として押しっぱなしにしている」ため、この層では押せない=
        //    そこに機能を置いてはいけない。BT_CLR_ALL は旧Del位置からBackSpace位置へ退避済(2026-08-14)。
        layer_6 {
            bindings = <
&bootloader  &trans        &trans        &trans        &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &bt BT_CLR_ALL  &trans                                               &trans
            >;
        };

        // SYMBOL: 左手Space長押し中。記号を出す層(2026-08-13新設)
        //   W=!  E=?  R=@ / D=(  F=) / C=<  V=>   ぜんぶ左手で完結する
        SYMBOL {
            bindings = <
&trans  &kp EXCLAMATION  &kp QUESTION           &kp AT_SIGN             &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans           &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS   &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &kp LESS_THAN          &kp GREATER_THAN        &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans           &trans                 &trans                  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // ENCODER: 無変換位置(Right Command)の長押し中。回転 = 音量上下。
        //   押し込みは Default 層で常時F13にしたので、この層では &trans で素通し(2026-08-14)。
        ENCODER {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };
};
